// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dados pessoais
  name String
  cpf  String @unique
  rg   String

  // Endereço
  cep          String
  street       String
  number       String
  neighborhood String
  city         String

  // Contato
  email     String
  phone     String
  birthDate String
  emergency String

  // Saúde
  useMedication            Boolean @default(false)
  useMedicationDescription String?

  healthProblem            Boolean @default(false)
  healthProblemDescription String?

  foodRestriction            Boolean @default(false)
  foodRestrictionDescription String?

  // Termos
  acceptTheTerms Boolean @default(false)

  // Pagamento
  payment String

  @@index([email])
  @@index([phone])
  @@index([city])
  @@map("registrations")
}
