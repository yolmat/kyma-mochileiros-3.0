generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDENTE
  PARCIAL
  PAGO
  CANCELADO
}

model Registration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  cpf  String @unique
  rg   String

  cep          String
  street       String
  number       String
  neighborhood String
  city         String

  email     String
  phone     String
  birthDate String
  emergency String

  useMedication            Boolean @default(false)
  useMedicationDescription String?

  healthProblem            Boolean @default(false)
  healthProblemDescription String?

  foodRestriction            Boolean @default(false)
  foodRestrictionDescription String?

  acceptTheTerms Boolean
  payment        String

  amountRegistration Decimal?
  amountPaid         Decimal?
  statusPayment      PaymentStatus @default(PENDENTE)
  datePayment        String?

  @@index([email])
  @@index([phone])
  @@index([city])
  @@map("registrations")
}
